# Supabase — create a project at https://supabase.com, then run supabase/schema.sql
# in the SQL editor. Both of these are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — used server-side only, for mining transcripts and for the
# between-matchup commentary line. Everything degrades gracefully without it.
ANTHROPIC_API_KEY=
